# Environment Variables for Production Deployment
# Copy this file to your server and update the values

# Database Configuration
export DB_HOST=localhost
export DB_PORT=3306
export DB_NAME=payments
export DB_USERNAME=payment_user
export DB_PASSWORD=your_secure_password_here

# Server Configuration
export SERVER_PORT=8080

# Security Configuration
export ADMIN_USERNAME=admin
export ADMIN_PASSWORD=your_admin_password_here

# External Services
export SIGNATURE_DECRYPT_URL=https://signal.avinertech.com/api/decrypt
export SIGNATURE_TIMEOUT=5000
export CALLBACK_TIMEOUT=10000

# CORS Configuration
export CORS_ALLOWED_ORIGINS=https://onboard.avinertech.com,https://www.onboard.avinertech.com,https://avinertech.com

# JVM Configuration
export JAVA_OPTS="-Xmx1024m -Xms512m -XX:+UseG1GC -XX:+UseContainerSupport -Dspring.profiles.active=production"

# Logging Configuration
export LOG_LEVEL=INFO
